        "\n",
        "# =========================\n",
        "# IMPORT\n",
        "# =========================\n",
        "\n",
        "import tensorflow as tf\n",
        "import tensorflow_datasets as tfds\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from keras.models import Sequential\n",
        "from keras.layers import Dense\n",
        "from keras.utils import to_categorical\n",
        "\n",
        "# =========================\n",
        "# LOAD DATASET\n",
        "# =========================\n",
        "\n",
        "# Load the EMNIST/letters dataset using TensorFlow Datasets\n",
        "(ds_train, ds_test), ds_info = tfds.load(\n",
        "    'emnist/letters',\n",
        "    split=['train', 'test'],\n",
        "    shuffle_files=True,\n",
        "    as_supervised=True, # Returns (image, label) tuples\n",
        "    with_info=True\n",
        ")\n",
        "\n",
        "# Function to extract and process images/labels from tf.data.Dataset\n",
        "def extract_data(dataset):\n",
        "    images = []\n",
        "    labels = []\n",
        "    for image, label in tfds.as_numpy(dataset):\n",
        "        # Image will be (28, 28, 1), squeeze to (28, 28) to match original code's expectation\n",
        "        images.append(np.squeeze(image))\n",
        "        labels.append(label)\n",
        "    return np.array(images), np.array(labels)\n",
        "\n",
        "x_train, y_train = extract_data(ds_train)\n",
        "x_test, y_test = extract_data(ds_test)\n",
        "\n",
        "# The original code normalizes after reshape, so we skip normalization here.\n",
        "# Labels from tfds.load('emnist/letters') are 1-26, consistent with extra_keras_datasets,\n",
        "# so the subsequent `y_train = y_train - 1` etc. should still apply.\n",
        "\n",
        "# =========================\n",
        "# SHOW SAMPLE IMAGE\n",
        "# =========================\n",
        "\n",
        "plt.imshow(x_train[2], cmap=plt.cm.binary)\n",
        "plt.title(\"Sample Letter\")\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# SHOW MULTIPLE IMAGES\n",
        "# =========================\n",
        "\n",
        "plt.figure(figsize=(10,8))\n",
        "\n",
        "for i in range(30):\n",
        "\n",
        "    plt.subplot(5,6,i+1)\n",
        "\n",
        "    plt.imshow(\n",
        "        x_train[1500+i],\n",
        "        cmap='gray',\n",
        "        interpolation='none'\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        'Letter: {}'.format(\n",
        "            chr(y_train[1500+i] + 64)\n",
        "        )\n",
        "    )\n",
        "\n",
        "    plt.xticks([])\n",
        "    plt.yticks([])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# RESHAPE DATA\n",
        "# =========================\n",
        "\n",
        "x_train = x_train.reshape(x_train.shape[0], 28*28)\n",
        "x_test = x_test.reshape(x_test.shape[0], 28*28)\n",
        "\n",
        "# =========================\n",
        "# NORMALIZE\n",
        "# =========================\n",
        "\n",
        "x_train = x_train.astype('float32') / 255\n",
        "x_test = x_test.astype('float32') / 255\n",
        "\n",
        "# =========================\n",
        "# FIX LABELS\n",
        "# EMNIST labels = 1 -> 26\n",
        "# Convert to 0 -> 25\n",
        "# =========================\n",
        "\n",
        "y_train = y_train - 1\n",
        "y_test = y_test - 1\n",
        "\n",
        "# =========================\n",
        "# ONE HOT ENCODING\n",
        "# =========================\n",
        "\n",
        "y_train = to_categorical(y_train, 26)\n",
        "y_test = to_categorical(y_test, 26)\n",
        "\n",
        "# =========================\n",
        "# BUILD ANN MODEL\n",
        "# =========================\n",
        "\n",
        "from keras.layers import Dropout\n",
        "\n",
        "model = Sequential()\n",
        "\n",
        "model.add(\n",
        "    Dense(\n",
        "        512,\n",
        "        activation='relu',\n",
        "        input_shape=(28*28,)\n",
        "    )\n",
        ")\n",
        "\n",
        "model.add(Dropout(0.3))\n",
        "\n",
        "model.add(\n",
        "    Dense(\n",
        "        128,\n",
        "        activation='relu'\n",
        "    )\n",
        ")\n",
        "\n",
        "model.add(Dropout(0.3))\n",
        "\n",
        "model.add(\n",
        "    Dense(\n",
        "        26,\n",
        "        activation='softmax'\n",
        "    )\n",
        ")\n",
        "# =========================\n",
        "# MODEL SUMMARY\n",
        "# =========================\n",
        "\n",
        "model.summary()\n",
        "\n",
        "# =========================\n",
        "# COMPILE MODEL\n",
        "# =========================\n",
        "\n",
        "model.compile(\n",
        "    optimizer='rmsprop',\n",
        "    loss='categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "\n",
        "# =========================\n",
        "# TRAIN MODEL\n",
        "# =========================\n",
        "\n",
        "history = model.fit(\n",
        "    x_train,\n",
        "    y_train,\n",
        "    epochs=20,\n",
        "    batch_size=128,\n",
        "    validation_data=(x_test, y_test)\n",
        ")\n",
        "plt.plot(history.history['accuracy'])\n",
        "\n",
        "plt.plot(history.history['val_accuracy'])\n",
        "\n",
        "plt.title('Model Accuracy')\n",
        "\n",
        "plt.ylabel('Accuracy')\n",
        "\n",
        "plt.xlabel('Epoch')\n",
        "\n",
        "plt.legend(['Train', 'Validation'])\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# EVALUATE MODEL\n",
        "# =========================\n",
        "\n",
        "test_loss, test_acc = model.evaluate(\n",
        "    x_test,\n",
        "    y_test\n",
        ")\n",
        "\n",
        "print(\"\\nTest Accuracy =\", test_acc)\n",
        "\n",
        "# =========================\n",
        "# PREDICT SAMPLE\n",
        "# =========================\n",
        "\n",
        "pred = model.predict(x_test)\n",
        "\n",
        "print(\n",
        "    \"\\nPrediction =\",\n",
        "    chr(np.argmax(pred[0]) + 65)\n",
        ")\n",
        "\n",
        "# =========================\n",
        "# SHOW TEST IMAGE\n",
        "# =========================\n",
        "\n",
        "plt.imshow(\n",
        "    x_test[0].reshape(28,28),\n",
        "    cmap='gray'\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Predicted: \" +\n",
        "    chr(np.argmax(pred[0]) + 65)\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# SAVE MODEL\n",
        "# =========================\n",
        "\n",
        "model.save(\"ann_letters_model.h5\")\n",
        "\n",
        "print(\"\\nMODEL SAVED SUCCESSFULLY\")"
      ]
